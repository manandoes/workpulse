# AgencyOS environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Database (PostgreSQL) ---
# Local development via docker-compose (see docker-compose.yml):
#   postgresql://agencyos:agencyos@localhost:5432/agencyos?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- Auth (NextAuth.js) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Base URL of the app, used for callbacks and invite links.
NEXTAUTH_URL="http://localhost:3000"
# Required when self-hosting (outside Vercel): tells Auth.js it may trust the
# Host header of incoming requests. Set this wherever you deploy, and make sure
# the host is pinned at your proxy/load balancer.
AUTH_TRUST_HOST="true"

# --- Transactional email (employee invites, approval notifications) ---
# Added in Phase 2 when the invite flow is built.
EMAIL_FROM="AgencyOS <noreply@example.com>"
RESEND_API_KEY=""

# --- Object storage (attachments, avatars) ---
# Added in Phase 5 when task attachments are built.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Background jobs (Phase 6 — workload recalculation) ---
# Architecture.md section 2 names BullMQ + Redis for this. No queue infra
# exists yet and no host is chosen (see Memory.md's open Phase 0 blocker), so
# for now the recalculation sweep runs behind a plain HTTP endpoint instead of
# a worker process. Point your scheduler (Vercel Cron, GitHub Actions, a
# server cron job) at POST /api/jobs/recalculate-workload with this as the
# bearer token. Generate with: openssl rand -base64 32
CRON_SECRET=""
